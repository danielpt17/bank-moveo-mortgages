# Copy to .env for local development outside Docker.
PORT=3000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://moveo:moveo@localhost:5432/moveo

# Redis
REDIS_URL=redis://localhost:6379
LOBBY_CACHE_TTL_SECONDS=300

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Demo customer (no real authentication in this assignment)
DEMO_CUSTOMER_ID=11111111-1111-4111-8111-111111111111

# Business-rule timezone used for the "submitted by the 23rd" rule
BUSINESS_TIMEZONE=Asia/Jerusalem
